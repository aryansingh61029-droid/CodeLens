# Copy to .env and replace these placeholders. Do not commit .env.
# Docker Compose loads .env automatically. Start-Local.ps1 loads it for Java.
DB_URL=jdbc:mysql://127.0.0.1:3306/codelens?connectionTimeZone=UTC
DB_USERNAME=codelens
DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
